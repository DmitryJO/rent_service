<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <changeSet id="V2-001-index-rental-orders-user-id" author="rent-service">
        <preConditions onFail="MARK_RAN">
            <and>
                <dbms type="postgresql"/>
                <tableExists schemaName="rent_service" tableName="rental_orders"/>
                <not>
                    <indexExists schemaName="rent_service" indexName="idx_rental_orders_user_id"/>
                </not>
            </and>
        </preConditions>
        <createIndex schemaName="rent_service" tableName="rental_orders" indexName="idx_rental_orders_user_id">
            <column name="user_id"/>
        </createIndex>
    </changeSet>

